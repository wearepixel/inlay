{
  "name": "wearepixel/inlay",
  "description": "Inlay - a Laravel-native visual composition layer for existing applications.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^5.0",
    "mockery/mockery": "^1.6",
    "laravel/pint": "^1.17",
    "pestphp/pest-plugin-browser": "^5.0",
    "larastan/larastan": "^3.10",
    "livewire/livewire": "^4.0"
  },
  "suggest": {
    "livewire/livewire": "Required to use Inlay's packaged administration interface (^4.0)."
  },
  "autoload": {
    "psr-4": {
      "WeArePixel\\Inlay\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WeArePixel\\Inlay\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "WeArePixel\\Inlay\\InlayServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "pest",
    "test:browser": "pest tests/Browser",
    "analyse": "phpstan analyse",
    "format": "pint"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "pestphp/pest-plugin-browser": true
    }
  }
}
